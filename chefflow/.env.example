# Copy to .env for local dev. These VITE_* vars are inlined into the client
# bundle at build time. See docs/getting-started.md and docs/deployment.md.

# Clerk publishable key — from https://dashboard.clerk.com (API Keys). Public.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# LLM mode: "groq" (direct, local dev) or "proxy" (Cloudflare Worker, production).
VITE_LLM_MODE=groq

# Groq API key — only needed when VITE_LLM_MODE=groq.
VITE_GROQ_API_KEY=

# Optional: enables LocationAutocomplete in the Event editor.
VITE_GOOGLE_MAPS_API_KEY=
