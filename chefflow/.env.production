# Production-build env vars. Loaded by Vite when running `vite build`
# (or `npm run deploy`). Git-ignored along with all .env* files.
#
# Point the SPA at the deployed chefflow-llm-proxy worker.
VITE_WORKER_BASE_URL=https://api.chefflow.uk
# Route LLM calls (recipe gen, analysis, workflow scheduler, description AI)
# through the worker proxy at /api/llm/*. Without this, the SPA defaults to
# direct-Groq mode and every chef has to paste their own Groq API key into
# Settings — which the description button doesn't currently gate, producing
# a confusing "missing API key" failure for users who never set one.
VITE_LLM_MODE=proxy
# Clerk DEV publishable key — safe to keep here (publishable keys are
# designed to be in client bundles). Pinned so a build from a clean
# checkout (or any machine without .env.local) still gets it baked in.
# Swap to pk_live_… once the Clerk production instance + DNS for
# clerk.chefflow.uk are live.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZW5nYWdpbmctYmF0LTUuY2xlcmsuYWNjb3VudHMuZGV2JA
